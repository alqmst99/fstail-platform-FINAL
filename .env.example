# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://fstail:fstail_dev@localhost:5432/fstail_platform"

# ─── Redis ───────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_64"
JWT_REFRESH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_64"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ─── NestJS API ──────────────────────────────────────────────────────
API_PORT=3001
API_URL="http://localhost:3001"
NODE_ENV="development"

# ─── Next.js Web App ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# ─── Groq AI (server-side only — never expose to client) ─────────────
GROQ_API_KEY="tu_clave_de_groq_aqui df"
GROQ_MODEL="llama-3.3-70b-versatile"

# ─── Email (for verification + password reset) ───────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="CHANGE_ME@gmail.com"
SMTP_PASS="CHANGE_ME"
SMTP_FROM="FSTail Solutions <no-reply@fstailsolutions.com.ar>"

# ─── App ────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
PLATFORM_NAME="FSTail Solutions"

# ─── Freelancer.com Developer API (OAuth 1.0a) ───────────────────────
# Create app: https://www.freelancer.com/developers
# Docs: https://developers.freelancer.com/
FREELANCER_CONSUMER_KEY=""
FREELANCER_CONSUMER_SECRET=""
FREELANCER_ACCESS_TOKEN=""
FREELANCER_ACCESS_TOKEN_SECRET=""
FREELANCER_USER_ID=""   # numeric user id of the freelancer account that places bids


# ─── Freelancer.com Developer API (OAuth 2.0) ───────────────────────
# App: https://www.freelancer.com/developers
# Status debe ser Approved para scopes avanzados (fln:project_manage)
FREELANCER_CLIENT_ID=""
FREELANCER_CLIENT_SECRET=""
FREELANCER_REDIRECT_URI="http://localhost:3000/callback"
# Después del flujo OAuth:
FREELANCER_ACCESS_TOKEN=""
FREELANCER_REFRESH_TOKEN=""
FREELANCER_USER_ID=""
