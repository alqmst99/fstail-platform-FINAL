<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  apps/desktop/assets/entitlements.mac.plist
  Required for macOS hardened runtime (notarization).
  safeStorage needs keychain access + JIT entitlements.
-->
<plist version="1.0">
  <dict>
    <!-- Allow the app to run JIT-compiled code (Electron/V8 requirement) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (required by Electron) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading dylibs with invalid signatures (Electron modules) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Keychain access — required for safeStorage (R-01 Groq key encryption) -->
    <key>com.apple.security.keychain-access-groups</key>
    <array>
      <string>$(AppIdentifierPrefix)com.fstailsolutions.platform</string>
    </array>

    <!-- Network access — required to reach the local Next.js server -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
  </dict>
</plist>
